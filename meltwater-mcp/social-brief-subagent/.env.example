# Copy to .env and fill in.

# Anthropic API key (the agents' reasoning). Create one at https://console.anthropic.com
# (Settings -> API Keys). Required for a standalone run — the Python SDK authenticates from this
# key, NOT from a Claude Code / `ant` CLI login, even if you're signed in there.
ANTHROPIC_API_KEY=

# Meltwater MCP (v2). Paste your v2 MCP API token here — the insight sub-agent sends it as a
# bearer token when it opens the Meltwater MCP client. (Confirm the exact token format / where to
# mint it with your Meltwater account team.)
MELTWATER_API_TOKEN=
MELTWATER_MCP_URL=https://api.meltwater.com/v2/mcp

# Which campaign to run. Fork campaigns/example-campaign.json and point this at your copy.
CAMPAIGN_CONFIG=campaigns/example-campaign.json
